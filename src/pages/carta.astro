---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import fondo from '../assets/vistas/carta/imagenes/fondo.webp';
import carta from '../assets/vistas/carta/imagenes/carta.webp';
---

<Layout title="Carta | Siete Sopas" description="La carta de Siete Sopas">
  <main id="vista-carta" class="min-h-svh flex items-center justify-center">
    <!-- Marco con la proporción del fondo, a todo el ancho de la pantalla -->
    <div class="vista-carta-marco relative">
      <!-- Fondo (borde rojo con la hoja de papel): primer fotograma del antiguo video -->
      <Image
        src={fondo}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover"
        widths={[1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
      />

      <!-- La carta, al centro de la hoja -->
      <Image
        src={carta}
        alt="Carta de Siete Sopas"
        class="vista-carta-imagen absolute h-auto"
        loading="eager"
        quality={95}
      />
    </div>
  </main>
</Layout>

<style>
  /* ===== Ajustes de la vista Carta ===== */
  #vista-carta {
    /* Tamaño de la carta respecto al marco (100% = todo el ancho del fondo).
       76% llena la hoja de papel; más grande ya se sale de la hoja. */
    --carta-ancho: 76%;
    /* Mover la carta (positivo = derecha / abajo, negativo = izquierda / arriba) */
    --carta-mover-x: 0%;
    --carta-mover-y: 0%;
    /* Color de relleno a los costados en pantallas más anchas que el fondo */
    --carta-fondo-color: #da1828;

    background: var(--carta-fondo-color);
  }

  /* El fondo es 2560×1900: el marco ocupa todo el ancho de la pantalla
     (si es más alto que la pantalla, se hace scroll) */
  .vista-carta-marco {
    aspect-ratio: 2560 / 1900;
    width: 100%;
  }

  .vista-carta-imagen {
    width: var(--carta-ancho);
    left: calc(50% + var(--carta-mover-x));
    top: calc(50% + var(--carta-mover-y));
    transform: translate(-50%, -50%);
  }
</style>
