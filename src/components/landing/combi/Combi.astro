---
// Sección: Combi (incluye la primera parte de Sopas: comparten el mismo fondo)
// Assets en src/assets/combi/ (imagenes, logos, animaciones)
import { Image } from "astro:assets";
import fondo from "../../../assets/combi/imagenes/fondo.mp4?url";
import fondoMovil from "../../../assets/combi/imagenes/fondo-movil.mp4?url";
import intermedio from "../../../assets/combi/imagenes/intermedio.webp";
import titulo from "../../../assets/combi/imagenes/titulo.webp";
import sopas from "../../../assets/combi/imagenes/sopas.webp";
// Textura de papel: la franja central de "intermedio", sin transparencia
import papel from "../../../assets/combi/imagenes/papel.webp";
// Franja durazno (semitransparente) que va detrás del texto en móvil
import intermedioDurazno from "../../../assets/combi/imagenes/intermedio-durazno.webp";
---

<section id="combi" class="relative w-full overflow-hidden">
  <!-- MÓVIL: papel entre la combi y las sopas (detrás del título y el texto) -->
  <Image
    src={papel}
    alt=""
    aria-hidden="true"
    class="combi-papel absolute left-0 w-full object-cover pointer-events-none"
    widths={[800, 1600]}
    sizes="100vw"
  />

  <!-- Video de fondo. Escritorio: completo (más ancho que la sección para esconder sus
       franjas blancas laterales). Móvil: solo la parte de la combi -->
  <video
    class="combi-video absolute top-0 h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src={fondoMovil} type="video/mp4" media="(max-width: 767px)" />
    <source src={fondo} type="video/mp4" />
  </video>

  <!-- MÓVIL: el mismo video otra vez, más chico, mostrando solo las sopas -->
  <video
    class="combi-video-2 absolute pointer-events-none"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <!-- Solo trae fuente en móvil: en escritorio no se descarga nada -->
    <source src={fondoMovil} type="video/mp4" media="(max-width: 767px)" />
  </video>

  <!-- Imagen intermedio: al medio del fondo -->
  <Image
    src={intermedio}
    alt=""
    aria-hidden="true"
    class="combi-intermedio absolute left-0 w-full h-auto pointer-events-none"
    widths={[800, 1600, 2400, 3307]}
    sizes="100vw"
  />

  <!-- MÓVIL: franja durazno agrandada, por debajo del título y el texto -->
  <Image
    src={intermedioDurazno}
    alt=""
    aria-hidden="true"
    class="combi-durazno absolute h-auto pointer-events-none"
    widths={[1600, 3307]}
    sizes="700vw"
  />

  <!-- Título y texto -->
  <div class="combi-contenido absolute inset-x-0 z-10 flex flex-col items-center text-center">
    <h2 class="combi-titulo">
      <Image src={titulo} alt="Nuestras Sopas" class="w-full h-auto" />
    </h2>

    <p class="combi-texto">
      En Siete Sopas, creemos que el alimento más poderoso es el cariño. Por
      eso, en cada cucharada de nuestras sopas y caldos, encontrarás no solo
      ingredientes seleccionados con manos bondadosas, sino
      <!-- saltos de línea solo en móvil, como en el prototipo -->
      <br class="combi-salto" />también el eco
      <br class="combi-salto" />de nuestras tradiciones.
    </p>
  </div>

  <!-- Nombres de las sopas, encima de los platos del video -->
  <Image
    src={sopas}
    alt="Caldo de Gallina y Sopa Criolla"
    class="combi-sopas absolute z-10 h-auto pointer-events-none"
  />
</section>

<style>
  /* ===== Ajustes de Combi ===== */
  #combi {
    /* Altura de la sección (75vw muestra el video completo).
       En móvil la combi y las sopas van separadas, con el título y el texto al medio. */
    --combi-altura: 246vw;        /* móvil */
    --combi-altura-md: 75vw;      /* escritorio (≥ 768px) */
    /* Posición vertical de la imagen intermedio dentro de la sección.
       0% = arriba, 50% = al medio, 100% = abajo */
    --combi-intermedio-posicion: 50%;
    /* Posición del título, medida desde el borde superior de la sección.
       Más grande = más abajo. px o vw. El texto se mueve con el título. */
    --combi-titulo-arriba: 84.5vw;    /* móvil */
    --combi-titulo-arriba-md: 30vw;   /* escritorio (≥ 768px) */
    /* Ancho del título */
    --combi-titulo-ancho: 70.4vw;     /* móvil */
    --combi-titulo-ancho-md: 480px;   /* escritorio (≥ 768px) */
    /* Separación entre el título y el texto (px o vw) */
    --combi-texto-separacion: 18vw;     /* móvil */
    --combi-texto-separacion-md: 40px;  /* escritorio (≥ 768px) */
    /* Tamaño del texto (1rem = 16px) */
    --combi-texto-tamano: 4.75vw;       /* móvil */
    --combi-texto-tamano-md: 1.8rem;    /* escritorio (≥ 768px) */
    /* Ancho máximo del texto (px o vw) */
    --combi-texto-ancho: 66vw;          /* móvil */
    --combi-texto-ancho-md: 1200px;     /* escritorio (≥ 768px) */
    /* Interlineado del texto (alto de cada línea respecto a la letra) */
    --combi-texto-interlineado: 1.53;   /* móvil */
    --combi-texto-interlineado-md: 1.7; /* escritorio (≥ 768px) */
    /* Color del texto */
    --combi-color: #7a5230;
    /* Nombres de las sopas (Caldo de Gallina / Sopa Criolla).
       arriba: distancia desde el borde superior (más grande = más abajo)
       ancho: tamaño de la imagen (más grande = nombres más grandes y más separados)
       mover-x: corre la imagen a los lados (positivo = derecha, negativo = izquierda) */
    --combi-sopas-arriba: 193.9vw;    /* móvil */
    --combi-sopas-arriba-md: 43.5vw;  /* escritorio (≥ 768px) */
    --combi-sopas-ancho: 82.7vw;      /* móvil */
    --combi-sopas-ancho-md: 47.5vw;   /* escritorio (≥ 768px) */
    --combi-sopas-mover-x: -1.9vw;    /* móvil */
    --combi-sopas-mover-x-md: 0px;    /* escritorio (≥ 768px) */
    /* MÓVIL: los dos recortes del video (ancho = tamaño; izquierda / arriba = posición).
       Video 1 = la combi, arriba. Video 2 = las sopas, abajo (va más chico). */
    --combi-video1-ancho: 267.6vw;
    --combi-video1-izquierda: -83.5vw;
    --combi-video1-arriba: -6vw;
    --combi-video2-ancho: 210vw;
    --combi-video2-izquierda: -56.3vw;
    --combi-video2-arriba: 120.8vw;
    /* MÓVIL: papel que llena entre la combi y las sopas (desde / hasta, medido desde arriba) */
    --combi-papel-desde: 86vw;
    --combi-papel-hasta: 176vw;
    /* MÓVIL: franja durazno detrás del texto.
       centro: a qué altura va el centro de la franja (medido desde arriba)
       ancho: tamaño (más grande = la franja cubre más alto) */
    --combi-durazno-centro: 135vw;
    --combi-durazno-ancho: 1200vw;

    height: var(--combi-altura);
  }

  /* Móvil: video 1 muestra la combi y se desvanece antes de llegar a las sopas */
  .combi-video,
  .combi-video-2 {
    /* Tailwind limita los videos a max-width: 100%; aquí debe poder ser más ancho */
    max-width: none;
    height: auto;
    aspect-ratio: 1280 / 766;
  }

  .combi-video {
    top: var(--combi-video1-arriba);
    left: var(--combi-video1-izquierda);
    width: var(--combi-video1-ancho);
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 64%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 64%);
  }

  /* Móvil: video 2 muestra solo las sopas (lo de arriba, la combi, queda oculto) */
  .combi-video-2 {
    top: var(--combi-video2-arriba);
    left: var(--combi-video2-izquierda);
    width: var(--combi-video2-ancho);
    -webkit-mask-image: linear-gradient(to bottom, transparent 35%, #000 43%);
    mask-image: linear-gradient(to bottom, transparent 35%, #000 43%);
  }

  .combi-papel {
    max-width: none;
    top: var(--combi-papel-desde);
    height: calc(var(--combi-papel-hasta) - var(--combi-papel-desde));
  }

  /* La franja está centrada a lo ancho; su parte visible es el 48% del alto de la imagen */
  .combi-durazno {
    max-width: none;
    width: var(--combi-durazno-ancho);
    left: 50%;
    top: calc(var(--combi-durazno-centro) - var(--combi-durazno-ancho) * 1440 / 3307 * 0.483);
    transform: translateX(-50%);
    z-index: 5;
  }

  /* En móvil el papel ya cubre el medio */
  .combi-intermedio {
    display: none;
  }

  .combi-intermedio {
    top: var(--combi-intermedio-posicion);
    transform: translateY(-50%);
    z-index: 5;
  }

  .combi-contenido {
    top: var(--combi-titulo-arriba);
    padding: 0 24px;
  }

  .combi-sopas {
    top: var(--combi-sopas-arriba);
    width: var(--combi-sopas-ancho);
    left: 50%;
    transform: translateX(calc(-50% + var(--combi-sopas-mover-x)));
  }

  .combi-titulo {
    width: var(--combi-titulo-ancho);
  }

  .combi-texto {
    width: 100%;
    max-width: var(--combi-texto-ancho);
    margin-top: var(--combi-texto-separacion);
    color: var(--combi-color);
    font-size: var(--combi-texto-tamano);
    line-height: var(--combi-texto-interlineado);
  }

  @media (min-width: 768px) {
    .combi-salto {
      display: none;
    }

    #combi {
      height: var(--combi-altura-md);
    }

    /* Escritorio: el video mide 2224px de ancho pero solo 1784px son dibujo (el resto
       son franjas blancas a los lados): se agranda y centra para que queden fuera */
    .combi-video {
      top: 0;
      height: 100%;
      aspect-ratio: auto;
      width: calc(100% * 2224 / 1784);
      left: calc(-100% * 220 / 1784);
      -webkit-mask-image: none;
      mask-image: none;
    }

    .combi-video-2,
    .combi-papel,
    .combi-durazno {
      display: none;
    }

    .combi-intermedio {
      display: block;
    }

    .combi-contenido {
      top: var(--combi-titulo-arriba-md);
      padding: 0 48px;
    }

    .combi-sopas {
      top: var(--combi-sopas-arriba-md);
      width: var(--combi-sopas-ancho-md);
      transform: translateX(calc(-50% + var(--combi-sopas-mover-x-md)));
    }

    .combi-titulo {
      width: var(--combi-titulo-ancho-md);
    }

    .combi-texto {
      max-width: var(--combi-texto-ancho-md);
      margin-top: var(--combi-texto-separacion-md);
      font-size: var(--combi-texto-tamano-md);
      line-height: var(--combi-texto-interlineado-md);
    }
  }
</style>
