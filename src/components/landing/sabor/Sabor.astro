---
// Sección: Sabor
// Solo queda el tablón de madera: hace de corte entre Servicio y Tiendas.
// Assets en src/assets/sabor/ (imagenes, logos, animaciones)
import { Image } from "astro:assets";
import tablon from "../../../assets/sabor/imagenes/tablon.webp";
---

<section id="sabor" class="relative w-full" aria-hidden="true">
  <!-- Tablón: centrado sobre la unión entre Servicio y Tiendas -->
  <Image
    src={tablon}
    alt=""
    class="sabor-tablon absolute h-auto pointer-events-none"
    widths={[800, 1600, 2400, 3307]}
    sizes="100vw"
  />
</section>

<style>
  /* ===== Ajustes de Sabor (tablón) =====
     Todo en vw, así que se ve en la misma proporción en móvil y escritorio. */
  #sabor {
    /* Mover el tablón respecto a la unión entre Servicio y Tiendas
       (0vw = centrado en la unión; positivo = más abajo, negativo = más arriba) */
    --sabor-tablon-mover-y: 0vw;
    /* Ancho del tablón (100% = todo el ancho; más grande = crece hacia los dos lados,
       lo que sobra a los costados se recorta). A 100% mide 12.7vw de alto. */
    --sabor-tablon-ancho: 100%;

    /* La sección no ocupa espacio: el tablón flota sobre la unión.
       z-index para que quede encima de Servicio y de Tiendas. */
    height: 0;
    z-index: 20;
    /* Recorta solo a los costados (evita scroll horizontal si el tablón es más ancho) */
    overflow-x: clip;
  }

  .sabor-tablon {
    top: var(--sabor-tablon-mover-y);
    left: 50%;
    width: var(--sabor-tablon-ancho);
    max-width: none;
    transform: translate(-50%, -50%);
  }
</style>
