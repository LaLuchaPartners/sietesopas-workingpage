---
// Sección: Carta2 (la carta en el atril + botón "Ver")
// Assets en src/assets/carta/carta2/ (imagenes, logos, animaciones)
import { Image } from "astro:assets";
import fondo from "../../../../assets/carta/carta2/imagenes/fondo.mp4?url";
import fondoMovil from "../../../../assets/carta/carta2/imagenes/fondo-movil.mp4?url";
import botonVer from "../../../../assets/carta/carta2/imagenes/boton-ver.webp";
---

<section id="carta2" class="relative w-full overflow-hidden">
  <!-- Video de fondo -->
  <video
    class="carta2-video absolute inset-x-0 w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src={fondoMovil} type="video/mp4" media="(max-width: 767px)" />
    <source src={fondo} type="video/mp4" />
  </video>

  <!-- Botón "Ver" → página de la carta -->
  <a
    href={`${import.meta.env.BASE_URL}carta`}
    class="carta2-boton absolute z-10"
    aria-label="Ver la carta"
  >
    <Image src={botonVer} alt="Ver" class="w-full h-auto" />
  </a>
</section>

<style>
  /* ===== Ajustes de Carta2 =====
     Todo está en vw (proporcional al ancho). Móvil: el video se amplía 1.553 veces
     para que la carta llene el ancho, como en el prototipo. */
  #carta2 {
    /* Cuánto se mete Carta2 por debajo de Carta1 (más grande = más arriba).
       El final de Carta1 se desvanece y deja ver este video. */
    --carta2-subir: 51.5vw;            /* móvil */
    --carta2-subir-md: 29.5vw;         /* escritorio (≥ 768px) */
    /* Altura de la sección (video completo; más chico = se recorta abajo) */
    --carta2-altura: 116vw;            /* móvil */
    --carta2-altura-md: 75vw;          /* escritorio (≥ 768px) */
    /* Video: ancho (el alto sale solo, 4:3) y cuánto se corre a la izquierda */
    --carta2-video-ancho: 155.3vw;     /* móvil */
    --carta2-video-ancho-md: 100vw;    /* escritorio (≥ 768px) */
    --carta2-video-izquierda: -29.5vw; /* móvil */
    --carta2-video-izquierda-md: 0vw;  /* escritorio (≥ 768px) */
    /* Botón "Ver": distancia desde el borde superior, tamaño y corrimiento lateral
       (positivo = derecha) */
    --carta2-boton-arriba: 1.6vw;      /* móvil */
    --carta2-boton-arriba-md: 8.8vw;   /* escritorio (≥ 768px) */
    --carta2-boton-ancho: 81.5vw;      /* móvil (la imagen trae mucho margen: las letras son ~20%) */
    --carta2-boton-ancho-md: 30vw;     /* escritorio (≥ 768px) */
    --carta2-boton-mover-x: 1.8vw;     /* móvil */
    --carta2-boton-mover-x-md: 0vw;    /* escritorio (≥ 768px) */
    /* Cuánto crece el botón al pasar el mouse (1.1 = 10% más grande) */
    --carta2-boton-hover: 1.1;

    height: var(--carta2-altura);
    margin-top: calc(-1 * var(--carta2-subir));
  }

  /* El video trae franjas blancas de 6px arriba y abajo: se agranda un poco
     y la sección (overflow-hidden) recorta ese sobrante */
  /* El video trae franjas blancas arriba y abajo: se agranda un poco y la sección
     (overflow-hidden) recorta ese sobrante */
  .carta2-video {
    max-width: none;
    right: auto;
    left: var(--carta2-video-izquierda);
    width: var(--carta2-video-ancho);
    top: calc(var(--carta2-video-ancho) * -0.004);
    height: calc(var(--carta2-video-ancho) * 0.758);
  }

  .carta2-boton {
    top: var(--carta2-boton-arriba);
    width: var(--carta2-boton-ancho);
    left: calc(50% + var(--carta2-boton-mover-x));
    transform: translateX(-50%);
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .carta2-boton:hover,
  .carta2-boton:focus-visible {
    transform: translateX(-50%) scale(var(--carta2-boton-hover));
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.6));
  }

  .carta2-boton:active {
    transform: translateX(-50%) scale(0.97);
  }

  .carta2-boton:focus-visible {
    outline: none;
  }

  @media (min-width: 768px) {
    #carta2 {
      --carta2-subir: var(--carta2-subir-md);
      --carta2-altura: var(--carta2-altura-md);
      --carta2-video-ancho: var(--carta2-video-ancho-md);
      --carta2-video-izquierda: var(--carta2-video-izquierda-md);
      --carta2-boton-arriba: var(--carta2-boton-arriba-md);
      --carta2-boton-ancho: var(--carta2-boton-ancho-md);
      --carta2-boton-mover-x: var(--carta2-boton-mover-x-md);
    }
  }
</style>
