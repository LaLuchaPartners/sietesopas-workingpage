---
// Sección: Servicio
// Assets en src/assets/servicio/ (imagenes, logos, animaciones)
import { Image } from "astro:assets";
import fondo from "../../../assets/servicio/imagenes/fondo.mp4?url";
import fondoMovil from "../../../assets/servicio/imagenes/fondo-movil.mp4?url";
import intermedio from "../../../assets/servicio/imagenes/intermedio.webp";
import titulo from "../../../assets/servicio/imagenes/titulo.webp";
import fotos1 from "../../../assets/servicio/imagenes/fotos-1.webp";
import fotos2 from "../../../assets/servicio/imagenes/fotos-2.webp";
import fotos3 from "../../../assets/servicio/imagenes/fotos-3.webp";
---

<section id="servicio" class="relative w-full">
  <!-- Video de fondo (cielo nocturno con los marcos) -->
  <div class="absolute inset-0 overflow-hidden">
    <video
      class="servicio-video absolute inset-x-0 top-0 w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src={fondoMovil} type="video/mp4" media="(max-width: 767px)" />
      <source src={fondo} type="video/mp4" />
    </video>
  </div>

  <!-- Imagen intermedio (nubes): tapa la unión con Carta2 -->
  <Image
    src={intermedio}
    alt=""
    aria-hidden="true"
    class="servicio-intermedio absolute left-0 w-full h-auto pointer-events-none"
    widths={[800, 1600, 2400, 3307]}
    sizes="100vw"
  />

  <!-- Título y texto -->
  <div class="servicio-contenido absolute inset-x-0 z-10 flex flex-col items-center text-center">
    <h2 class="servicio-titulo">
      <Image src={titulo} alt="Servicio" class="w-full h-auto" />
    </h2>

    <p class="servicio-texto">
      En Siete Sopas, el servicio no es solo una atención, es un acto de
      cuidado que comienza mucho antes de que la cuchara toque el plato. Es el
      arte de recibirte con la misma alegría con la que se espera a un hijo que
      vuelve a casa después de un largo viaje. Al cruzar nuestro umbral, el
      murmullo de las conversaciones se mezcla con el aroma del pan recién
      salido del horno de leña, ese compañero fiel que llega a tu mesa como un
      regalo de bienvenida.
    </p>
  </div>

  <!-- Fotos de los marcos, en tres grupos que se ubican por separado:
       1 = foto redonda de arriba, 2 = las tres del medio, 3 = la fila de abajo -->
  <Image
    src={fotos1}
    alt="Colaboradora de Siete Sopas sirviendo empanadas"
    class="servicio-fotos servicio-fotos-1 absolute z-[1] h-auto pointer-events-none"
    widths={[400]}
    sizes="25vw"
  />
  <Image
    src={fotos2}
    alt="Nuestro equipo atendiendo a los comensales"
    class="servicio-fotos servicio-fotos-2 absolute z-[1] h-auto pointer-events-none"
    widths={[800, 1250]}
    sizes="76vw"
  />
  <Image
    src={fotos3}
    alt="Colaboradores de Siete Sopas en el local"
    class="servicio-fotos servicio-fotos-3 absolute z-[1] h-auto pointer-events-none"
    widths={[800, 1278]}
    sizes="78vw"
  />
</section>

<style>
  /* ===== Ajustes de Servicio ===== */
  #servicio {
    /* Cuánto se monta Servicio sobre el final de Carta2 (más grande = más arriba) */
    --servicio-subir: 1vw;
    /* Altura de la sección (el video completo mide 225vw; más chico = se recorta abajo) */
    --servicio-altura: 225vw;
    /* Posición de las nubes respecto al borde superior de Servicio
       (0px = centradas en la unión; positivo = más abajo, negativo = más arriba) */
    --servicio-intermedio-mover-y: -5vw;
    /* Título: distancia desde el borde superior (el texto se mueve con él) y ancho */
    --servicio-titulo-arriba: 17.5vw;     /* móvil */
    --servicio-titulo-arriba-md: 17.5vw;  /* escritorio (≥ 768px) */
    --servicio-titulo-ancho: 30vw;        /* móvil */
    --servicio-titulo-ancho-md: 23vw;     /* escritorio (≥ 768px) */
    /* Separación entre el título y el texto */
    --servicio-texto-separacion: 8px;      /* móvil */
    --servicio-texto-separacion-md: 4vw;   /* escritorio (≥ 768px) */
    /* Tamaño del texto (1rem = 16px) */
    --servicio-texto-tamano: 0.7rem;       /* móvil */
    --servicio-texto-tamano-md: 1.4rem;    /* escritorio (≥ 768px) */
    /* Ancho máximo del texto */
    --servicio-texto-ancho: 100%;          /* móvil */
    --servicio-texto-ancho-md: 66vw;       /* escritorio (≥ 768px) */
    /* Color del texto */
    --servicio-color: #f3ead8;
    /* Fotos de los marcos, cada grupo por separado (arriba / izquierda = posición,
       ancho = tamaño).
       Fotos 1: la redonda de arriba */
    --servicio-fotos1-arriba: 44vw;
    --servicio-fotos1-izquierda: 37.67vw;
    --servicio-fotos1-ancho: 24.19vw;
    /* Fotos 2: las tres del medio */
    --servicio-fotos2-arriba: 83.65vw;
    --servicio-fotos2-izquierda: 13.05vw;
    --servicio-fotos2-ancho: 74.1vw;
    /* Fotos 3: la fila de abajo */
    --servicio-fotos3-arriba: 132.95vw;
    --servicio-fotos3-izquierda: 11.4vw;
    --servicio-fotos3-ancho: 76.25vw;

    height: var(--servicio-altura);
    margin-top: calc(-1 * var(--servicio-subir));
  }

  /* Video 1820×4096 → a todo el ancho mide 225vw de alto */
  .servicio-video {
    max-width: none;
    height: 225vw;
  }

  .servicio-intermedio {
    top: var(--servicio-intermedio-mover-y);
    transform: translateY(-50%);
    z-index: 5;
  }

  .servicio-contenido {
    top: var(--servicio-titulo-arriba);
    padding: 0 24px;
  }

  .servicio-titulo {
    width: var(--servicio-titulo-ancho);
  }

  .servicio-texto {
    width: 100%;
    max-width: var(--servicio-texto-ancho);
    margin-top: var(--servicio-texto-separacion);
    color: var(--servicio-color);
    font-size: var(--servicio-texto-tamano);
    line-height: 1.9;
  }

  .servicio-fotos {
    max-width: none;
  }

  .servicio-fotos-1 {
    top: var(--servicio-fotos1-arriba);
    left: var(--servicio-fotos1-izquierda);
    width: var(--servicio-fotos1-ancho);
  }

  .servicio-fotos-2 {
    top: var(--servicio-fotos2-arriba);
    left: var(--servicio-fotos2-izquierda);
    width: var(--servicio-fotos2-ancho);
  }

  .servicio-fotos-3 {
    top: var(--servicio-fotos3-arriba);
    left: var(--servicio-fotos3-izquierda);
    width: var(--servicio-fotos3-ancho);
  }

  @media (min-width: 768px) {
    .servicio-contenido {
      top: var(--servicio-titulo-arriba-md);
      padding: 0 48px;
    }

    .servicio-titulo {
      width: var(--servicio-titulo-ancho-md);
    }

    .servicio-texto {
      max-width: var(--servicio-texto-ancho-md);
      margin-top: var(--servicio-texto-separacion-md);
      font-size: var(--servicio-texto-tamano-md);
    }
  }
</style>
